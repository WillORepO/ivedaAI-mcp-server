# Copy to .env, or set these in your MCP client's server config.
# Only the first three are required.

IVEDAAI_BASE_URL=https://ivedaai.example.com
IVEDAAI_USERNAME=your-username
IVEDAAI_PASSWORD=your-password

# Serve reads only: GETs and verified query-only alert POSTs. Mutating operations
# are withheld. Recommended while evaluating.
# IVEDAAI_READ_ONLY=true

# Permit the 21 DELETEs that name no record (e.g. DELETE /api/cameras).
# Withheld by default because what they do with an omitted body is unspecified.
# IVEDAAI_ALLOW_COLLECTION_DELETE=true

# Mask credential-shaped fields in responses. On by default.
# IVEDAAI_REDACT_SECRETS=false

# Skip TLS certificate verification, for on-prem self-signed certificates.
# Traffic stays encrypted; the certificate is not checked.
# IVEDAAI_ALLOW_INSECURE_TLS=true

# Per-request timeout in ms (default 30000). Some IvedaAI endpoints block rather
# than failing fast when a camera is unreachable.
# IVEDAAI_TIMEOUT_MS=30000

# Response bytes read before truncating (default 28672). Sized for what a model
# client can receive, not for what the API can send.
# IVEDAAI_MAX_RESPONSE_BYTES=28672

# Image endpoints return the picture itself, viewable in the client, rather than
# a description of it. Set to false to get only the description.
# IVEDAAI_INLINE_IMAGES=false

# Images get their own, larger budget (default 4194304 = 4 MB): a client charges
# for an image by its dimensions, not by the size of its base64, so the response
# cap above would truncate every one of them for no saving. A partly-read image
# is a corrupt file, so it is described instead of attached.
# IVEDAAI_MAX_IMAGE_BYTES=4194304

# Confine file uploads to one directory. 25 operations accept a file, and the
# path for one is chosen by a model from whatever is in its context — including
# text this server returned from your deployment. Uploads are disabled while
# this is unset unless the explicit compatibility escape hatch below is true.
# IVEDAAI_UPLOAD_ROOT=/path/to/uploads

# Compatibility escape hatch only. Prefer a confined root.
# IVEDAAI_ALLOW_UNCONFINED_UPLOADS=false

# Largest file this server will upload (default 67108864 = 64 MB). Reads stop
# at this cap even if the file grows after validation.
# IVEDAAI_MAX_UPLOAD_BYTES=67108864

# Only if your deployment requires client credentials on the token request.
# IVEDAAI_CLIENT_ID=
# IVEDAAI_CLIENT_SECRET=

# Point at your own OpenAPI 3 document if your deployment differs from the
# bundled 10.0 one.
# IVEDAAI_SWAGGER_PATH=/path/to/openapi.json
